# Tailscale IPv4 of the NAS, used only by private coturn.
TAILSCALE_IP=100.64.0.10
# Generate with: openssl rand -hex 32
TURN_AUTH_SECRET=replace-with-a-long-random-secret
TURN_REALM=cellbridge-nas.tailnet.ts.net
VERSION=dev
TARGETARCH=amd64
# Path is resolved relative to this compose file. Use ../config.nas-qdc507.example.yaml
# for the validated Baiwang QDC507 ARM64 NAS profile.
CELLBRIDGE_CONFIG=../config.example.yaml
# The Gateway is exposed only by host Tailscale Serve; Funnel is forbidden.
CELLBRIDGE_NETWORK_MODE=tailnet
CELLBRIDGE_PUBLIC_FALLBACK=false
CELLBRIDGE_TURN_MODE=tailnet-private
# Optional Authorization value for the external push broker.
CELLBRIDGE_PUSH_BROKER_AUTHORIZATION=
